# ============================================================================
# MEDIA SCOPE IT LTD — BACKEND PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================

# Application Environment & Server Port
NODE_ENV=production
PORT=5000

# Security & Session Credentials
JWT_SECRET=YOUR_PRODUCTION_HIGH_ENTROPY_JWT_SECRET_HERE

# Production CORS & Base URLs
SERVER_BASE_URL=https://mediascopeit.com
FRONTEND_BASE_URL=https://mediascopeit.com

# MySQL Production Database Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mediascope_db
DB_USER=mediascope_user
DB_PASSWORD=YOUR_STRONG_PRODUCTION_DB_PASSWORD_HERE

# SSLCommerz Payment Gateway Configuration
SSLCOMMERZ_STORE_ID=YOUR_PRODUCTION_SSLCOMMERZ_STORE_ID
SSLCOMMERZ_STORE_PASSWORD=YOUR_PRODUCTION_SSLCOMMERZ_STORE_PASSWORD
SSLCOMMERZ_SANDBOX=false
SSLCOMMERZ_MODE=live
